{
  "version": 3,
  "configurePresets": [
    {
      "name": "fp3d-msvc",
      "displayName": "FP3D: Windows Tiles Sounds x64 MSVC (vcpkg at D:/vcpkg)",
      "inherits": "windows-tiles-sounds-x64-msvc",
      "binaryDir": "${sourceDir}/out/build/fp3d-msvc",
      "environment": { "VCPKG_ROOT": "D:/vcpkg" },
      "cacheVariables": {
        "LOCALIZE": "False",
        "SOUND": "False",
        "CMAKE_PROJECT_INCLUDE_BEFORE": "${sourceDir}/build-scripts/windows-tiles-sounds-x64-msvc.cmake",
        "VCPKG_INSTALLED_DIR": "D:/vcpkg/installed-cdda"
      }
    }
  ]
}
